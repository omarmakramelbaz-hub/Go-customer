{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "fasakhaninjatest",
          "appId": "1:224648167390:android:d4d87f98dfe5ddf556274f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "fasakhaninjatest",
          "appId": "1:224648167390:ios:7b0a8844f171b56556274f",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "fasakhaninjatest",
          "configurations": {
            "android": "1:224648167390:android:d4d87f98dfe5ddf556274f",
            "ios": "1:224648167390:ios:7b0a8844f171b56556274f"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
